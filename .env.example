# `npm run anchor:setup -- --own-asset` bunların hepsini üretir. Elle doldurmanız gerekmez.
# Gizli anahtarlar YALNIZCA testnet. Asla mainnet anahtarı koymayın.
ANCHOR_SECRET=S...            # demo anchor'ın imza anahtarı (= stellar.toml SIGNING_KEY)
ANCHOR_PUBLIC=G...
ANCHOR_ASSET=RIP:G...         # ya da USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ANCHOR_DELIVERY_SECONDS=90    # ilan edilen teslim süresi (demoda kısa; üretimde saatler/günler)
ANCHOR_PORT=4200
DEMO_USER_SECRET=S...         # headless kontroller için; sahnede Freighter imzalar
DEMO_USER_PUBLIC=G...
ISSUER_SECRET=S...            # test varlığının ihraççısı — musluk için (USDC modunda yok)
RIPCORD_BOND_CONTRACT=C...    # Katman 1 sözleşmesi (WASM yoksa atlanır)
ARBITER_SECRET=S...           # DEMO hakemi — üretimde bağımsız taraf
ARBITER_PUBLIC=G...
